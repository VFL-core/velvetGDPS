{
    "geode": "v5.0.0-beta.1",
    "gd": {
        "android": "2.2081",
        "win": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "version": "v1.7.13",
    "id": "velvet.demonlist",
    "name": "velvet Demonlist",
    "developer": "velvet",
    "description": "official demonlist for velvetgdps",
    "resources": {
        "files": [
            "resources/*.frag",
            "resources/*.vert"
        ],
        "sprites": [
            "resources/*.png"
        ]
    },
    "settings": {
        "list-api-url": {
            "name": "Demonlist URL",
            "description": "The raw JSON endpoint for fetching list placements.",
            "type": "string",
            "default": "https://raw.githubusercontent.com/VFL-core/velvetGDPS/refs/heads/main/data/List.json"
        },
        "enable-rank": {
            "name": "Enable Demon Ranking Text",
            "description": "Whether or not to display the demon ranking text.",
            "type": "bool",
            "default": true
        },
        "white-rank": {
            "name": "White Demon Ranking Text",
            "description": "Whether or not to display the demon ranking text in white.",
            "type": "bool",
            "enable-if": "enable-rank",
            "default": false
        }
    },
    "dependencies": {
        "geode.node-ids": "v1.9.0"
    },
    "links": {
        "community": "https://discord.gg/QVKmbvBXA7",
        "homepage": "https://www.hiimjasmine00.com"
    },
    "tags": [
        "content",
        "enhancement",
        "interface",
        "online",
        "utility"
    ]
}
